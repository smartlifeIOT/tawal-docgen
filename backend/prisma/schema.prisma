generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Unit Price List — the commercial reference (imported from UPL.xlsx).
/// Prices are versioned so historical packages keep the price they were costed with.
model UplItem {
  id           String   @id @default(uuid())
  version      String   @default("v1")
  line         Int?
  itemCode     String
  description  String   @db.Text
  categoryName String?
  /// "Tangible" or "Service" — the UPL classifies each item, and the GCL's
  /// "Tangible Or Service item" column prints it.
  itemType     String?
  uom          String?
  price        Decimal  @db.Decimal(14, 4)
  currency     String   @default("SAR")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([version, itemCode])
  @@index([itemCode])
  @@map("upl_items")
}

enum QuantitySource {
  DESIGN
  AS_BUILT
}

enum PackageStatus {
  DRAFT
  READY
  GENERATED
}

/// Whether the package started life as a signed GCL upload, or as a scope-of-work
/// sheet that this system turned into a GCL.
enum PackageOrigin {
  GCL_UPLOAD
  SCOPE_SHEET
}

/// One GCL = one work-order package = one BOQ + one WO + one PAC.
model Package {
  id             String         @id @default(uuid())
  status         PackageStatus  @default(DRAFT)
  origin         PackageOrigin  @default(GCL_UPLOAD)
  quantitySource QuantitySource @default(AS_BUILT)
  uplVersion     String         @default("v1")

  /// Which parsed column drives pricing. Set by the user after the document is
  /// read, rather than assuming a fixed "Design"/"As-Built" pair — different
  /// GCLs and scope sheets label their quantity columns differently.
  quantityFieldKey   String?
  quantityFieldLabel String?

  /// Every numeric column the parser found, so the choice can be revisited
  /// without re-uploading: [{ key, label, total }]
  quantityFields Json?

  /// Read from the sign-off box and then confirmed by the person uploading —
  /// see acceptance.detector.ts for why it is not trusted blind.
  acceptance Acceptance?

  /// Set when this package arrived as part of a multi-GCL upload.
  gclBatchId String?
  gclBatch   GclBatch? @relation(fields: [gclBatchId], references: [id], onDelete: SetNull)

  // --- Identity (parsed from the GCL header) ---
  woNumber       String
  siteNo         String
  tawalSiteId    String?
  region         String?
  district       String?
  siteName       String?
  budget         String?
  subProjectName String?

  /// Snapshot of the tracker project this GCL was raised against. Kept as plain
  /// columns rather than a relation — the source is an external service that may
  /// change or disappear, and the package must still read correctly.
  externalProjectId    String?
  externalSiteId       String?
  externalProjectTitle String?
  externalCategory     String?
  projectName    String         @default("SMART TOWER")
  contractorName String         @default("SMART LIFE")
  poNumber       String?
  poValue        Decimal?       @db.Decimal(14, 2)

  // --- Dates ---
  gclDate      DateTime?
  serviceDate  DateTime?
  handoverDate DateTime?
  startDate    DateTime?
  endDate      DateTime?

  // --- Signatories ---
  contractorPmName String?
  /// When the contractor signed the GCL — carried onto the PAC and FAC. Not
  /// the same as gclDate, which is the date printed in the header.
  contractorSignDate DateTime?
  contractorPmId   String?
  mspRepName       String?
  mspSignDate      DateTime?
  tawalPmName      String?
  tawalPmId        String?

  /// Contractor signature supplied at GCL-creation time. Stamped on every row's
  /// "IMPL Contr. Initial" cell and in the signature block. The company stamp is
  /// a fixed asset and is not stored per package.
  signatureFileName String?
  signaturePath     String?

  // --- Commercials ---
  currency    String  @default("SAR")
  grossAmount Decimal @default(0) @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2)
  foc         Decimal @default(0) @db.Decimal(14, 2)
  netAmount   Decimal @default(0) @db.Decimal(14, 2)

  notes          String? @db.Text
  sourceFileName String?
  sourceFilePath String?
  parseWarnings  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines     PackageLine[]
  documents GeneratedDocument[]

  @@unique([woNumber])
  @@index([siteNo])
  @@map("packages")
}

model PackageLine {
  id        String  @id @default(uuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  no          Int
  itemCode    String
  description String  @db.Text
  unit        String?
  itemType    String? // Tangible | Service
  workType    String?

  designQty  Decimal @db.Decimal(12, 2)
  asBuiltQty Decimal @db.Decimal(12, 2)
  quantity   Decimal @db.Decimal(12, 2) // resolved from the selected column

  /// All quantity columns for this line, keyed as in Package.quantityFields.
  quantities Json?

  serialNumber String?
  tagNumber    String    @default("N/A")
  serviceDate  DateTime?

  unitPrice  Decimal @db.Decimal(14, 4)
  lineTotal  Decimal @db.Decimal(14, 2)
  priceFound Boolean @default(true)

  sortOrder Int @default(0)

  @@index([packageId])
  @@map("package_lines")
}

enum DocumentType {
  GCL_PDF
  FAC_PDF
  PAC_XLSX
  FAC_XLSX
  BOQ_XLSX
  BOQ_PDF
  WO_PDF
  WO_XLSX
  PAC_PDF
  BUNDLE_ZIP
}

/// One upload of many signed GCLs.
///
/// Each file still becomes its own package — separate site, separate
/// quantities, separate acceptance. What the batch adds is the combined
/// paperwork Tawal wants: one BOQ and one Work Order covering every site, and
/// certificates split by what was ticked.
model GclBatch {
  id        String @id @default(uuid())
  reference String @unique
  fileCount Int    @default(0)
  siteCount Int    @default(0)

  currency  String  @default("SAR")
  netAmount Decimal @default(0) @db.Decimal(14, 2)

  /// Files that could not be read, kept so failures stay visible.
  errors Json?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  packages  Package[]
  documents GeneratedDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gcl_batches")
}

model GeneratedDocument {
  id        String       @id @default(uuid())
  /// A document belongs to one package or to a whole batch, never both.
  packageId String?
  package   Package?  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  gclBatchId String?
  gclBatch   GclBatch? @relation(fields: [gclBatchId], references: [id], onDelete: Cascade)
  type      DocumentType
  fileName  String
  path      String
  sizeBytes Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([packageId, type])
  @@map("generated_documents")
}


/* ===========================================================================
   Access control — the whole platform is behind login, not just MOP.
   An Admin creates PM accounts; PMs can use everything except user management.
   =========================================================================== */

enum UserRole {
  ADMIN
  PM
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(PM)
  isActive     Boolean  @default(true)
  mustChangePassword Boolean @default(true)

  /// Per-resource grants for non-admin accounts, e.g.
  /// { "projects": { "view": true, "create": true } }.
  /// Admins bypass this entirely — see src/modules/auth/permissions.ts.
  permissions Json?
  lastLoginAt  DateTime?

  createdById  String?
  createdBy    User?    @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]   @relation("UserCreatedBy")

  mopDocuments MopDocument[]
  mopBatches   MopBatch[]
  gclBatches   GclBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("users")
}

/* ===========================================================================
   Method of Procedure (MOP)

   ProjectCategory (RMS, CCTV, SIM Swap, Smart Locks) x MopCategory (Survey,
   Installation, PAT) -> a template pairing -> MopDocument. All of it is data,
   not code, so new categories are added from the UI without a deploy.
   =========================================================================== */

/// A kind of project, mirrored from the tracker's `category` field.
///
/// These are not authored here: the row exists so MOP categories can be paired
/// against it and so a colour can be set. A category the tracker stops using is
/// kept, because documents generated under it still reference it.
model ProjectCategory {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  colour      String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  /// Last time the tracker was seen using this category.
  lastSeenAt DateTime?

  templates CategoryTemplate[]
  documents MopDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("project_categories")
}

/// A stage of work — Survey, Installation, PAT. Also user-managed.
model MopCategory {
  id        String  @id @default(uuid())
  name      String
  slug      String  @unique
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  templates CategoryTemplate[]
  documents MopDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mop_categories")
}

/// Which MOP categories apply to which project category, and which Word
/// template each pairing produces. This is where "SIM Swap is survey-only"
/// lives: no row, no option.
model CategoryTemplate {
  id                String          @id @default(uuid())
  projectCategoryId String
  projectCategory   ProjectCategory @relation(fields: [projectCategoryId], references: [id], onDelete: Cascade)
  mopCategoryId     String
  mopCategory       MopCategory     @relation(fields: [mopCategoryId], references: [id], onDelete: Cascade)

  templateKey       String
  defaultTcnSummary String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectCategoryId, mopCategoryId])
  @@map("category_templates")
}

/// What the MSP ticked on the signed GCL, which decides the certificate:
/// oil-free work is finally accepted (FAC), work accepted with oil is still
/// provisional (PAC), and a rejection gets neither.
enum Acceptance {
  ACCEPTED
  ACCEPTED_WITH_OIL
  REJECTED
}

enum SiteImpact {
  NO
  YES
}

model MopDocument {
  id        String  @id @default(uuid())
  /// The tracker project this MOP was raised for. Stored as a snapshot rather
  /// than a relation: the tracker owns projects, and a MOP must still read
  /// correctly if one is renamed or withdrawn upstream.
  externalProjectId String?
  /// Optional: a MOP can be raised without a tracker project — a survey before
  /// the project exists, or an ad-hoc request. Then this holds the site or
  /// project name typed by hand, and the category is chosen directly.
  externalSiteId       String?
  externalProjectTitle String?
  externalCategory     String?

  /// Resolved from externalCategory at creation, and what decides which MOP
  /// categories were available.
  projectCategoryId String?
  projectCategory   ProjectCategory? @relation(fields: [projectCategoryId], references: [id])

  mopCategoryId String
  mopCategory   MopCategory @relation(fields: [mopCategoryId], references: [id])

  /// Snapshotted at generation time, so re-templating a category later doesn't
  /// change what an already-issued document says it was built from.
  templateKey String?

  // --- the five Document Control fields ---
  tcnSummary    String
  siteId        String
  requesterName String
  pmName        String
  siteImpact    SiteImpact @default(NO)
  siteImpactNote String?   // e.g. "NO - No Impact"

  docxFileName String?
  docxPath     String?
  pdfFileName  String?
  pdfPath      String?

  batchId String?
  batch   MopBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([externalSiteId])
  @@index([mopCategoryId])
  @@index([siteId])
  @@map("mop_documents")
}

model MopBatch {
  id       String @id @default(uuid())
  fileName String
  total    Int    @default(0)
  succeeded Int   @default(0)
  failed   Int    @default(0)
  errors   Json?
  zipPath  String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  documents MopDocument[]
  createdAt DateTime @default(now())

  @@map("mop_batches")
}
